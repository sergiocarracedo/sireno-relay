---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import DocsLayout from "../../components/DocsLayout.astro";
import { slug } from "../../lib/docs";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({ params: { slug: slug(entry) }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props as { entry: CollectionEntry<"docs">; entries: CollectionEntry<"docs">[] };
const { Content, headings } = await render(entry);
---
<DocsLayout entry={entry} entries={entries} Content={Content} headings={headings} />
