---
import Button from "../components/Button.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import MailBoundaryDiagram from "../components/MailBoundaryDiagram.astro";
import RelayIsometricDiagram from "../components/RelayIsometricDiagram.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/with-base";
import { version } from "../lib/version";

const setupPrompt = "First install the SirenoRELAY setup skill with `npx skills add sergiocarracedo/sireno-relay --skill sirenorelay`. Then read and use that skill to help me install and configure SirenoRELAY on an owner-controlled account. Verify the Homebrew formula is published before using it. Keep upstream mail credentials and the relay configuration out of the agent environment; guide me through onboarding and policy validation without asking me to paste secrets into chat.";
---

<SiteLayout title="SirenoRELAY — constrained email for agents" description="Give agents narrowly scoped, policy-filtered email access without upstream credentials.">
  <SiteHeader home />
  <main>
    <section class="hero hero--stitch shell">
      <div class="hero-aura" aria-hidden="true"></div>
      <div class="hero-copy">
        <p class="eyebrow eyebrow--pill"><span class="status-pulse"></span> A PRIVATE POST OFFICE · v{version}</p>
        <h1>Email access, <em>on your terms.</em></h1>
        <p class="lede">A policy boundary between your mailbox and an agent. It lets the useful mail through—and keeps the rest, including your credentials, where it belongs.</p>
        <div class="hero-actions"><Button href="#install">Getting started <span>→</span></Button><Button href="#comparison" variant="secondary">Watch it work <span>↓</span></Button></div>
      </div>
      <figure class="hero-figure hero-canvas" aria-label="An owner mailbox sends approved messages through the SirenoRELAY policy boundary to an agent.">
        <svg viewBox="0 0 620 560" role="img" aria-hidden="true">
          <defs><pattern id="paper-grid" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M12 0H0V12" fill="none" stroke="currentColor" stroke-width=".45" opacity=".13"/></pattern></defs>
          <rect x="34" y="42" width="552" height="452" rx="2" class="figure-paper"/>
          <rect x="34" y="42" width="552" height="452" rx="2" fill="url(#paper-grid)" class="figure-grid"/>
          <path d="M73 128H222V405H73M401 128H548V405H401" class="figure-frame"/>
          <text x="74" y="101" class="figure-label">OWNER MAILBOX</text><text x="401" y="101" class="figure-label">AGENT VIEW</text>
          <path d="M88 186h76l18 19h49v108H88z" class="figure-folder"/><path d="M88 205h143" class="figure-line"/>
          <text x="108" y="247" class="figure-body">Invoices</text><text x="108" y="274" class="figure-small">3 messages</text>
          <path d="M104 315h103M104 336h84M104 357h97" class="figure-mail"/>
          <path d="M255 115V420" class="figure-boundary"/><text x="241" y="94" class="figure-boundary-label">POLICY</text>
          <path d="M224 246H255M255 246h43" class="figure-route"/><path d="M286 237l12 9-12 9" class="figure-route"/>
          <circle cx="255" cy="246" r="17" class="figure-seal"/><path d="m248 246 5 5 10-11" class="figure-check"/>
          <path d="M326 188h148v159H326z" class="figure-agent"/><path d="M326 219h148" class="figure-line"/><circle cx="347" cy="204" r="5" class="figure-dot"/><text x="365" y="209" class="figure-small">ALLOWED RESULTS</text>
          <path d="M347 252h101M347 275h78M347 299h92" class="figure-mail figure-allowed"/>
          <path d="M104 389h103" class="figure-denied"/><path d="m152 379 14 20m0-20-14 20" class="figure-denied"/>
          <text x="99" y="429" class="figure-small">hidden by policy</text>
          <text x="73" y="462" class="figure-caption">CREDENTIALS REMAIN WITH THE OWNER</text>
        </svg>
        <figcaption><span>Policy enforced</span> The relay makes the mailbox legible to an agent—without making it available.</figcaption>
      </figure>
    </section>

    <RelayIsometricDiagram />

    <section id="comparison" class="comparison-section"><div class="shell"><MailBoundaryDiagram /></div></section>

    <section id="policy-engine" class="feature-band shell" aria-labelledby="features-title">
      <div class="feature-intro" data-reveal><p class="eyebrow eyebrow--pill">POLICY ENGINE</p><h2 id="features-title">A mailbox view shaped by <em>policy,</em> not trust.</h2></div>
      <div class="feature-grid">
        <article data-reveal><span>01</span><h3>Folders disappear</h3><p>Unapproved folders never become part of the agent’s mailbox view or virtual IDs.</p></article>
        <article data-reveal><span>02</span><h3>Senders are checked</h3><p>An allowed recipient cannot make an unapproved <code>From</code> sender visible.</p></article>
        <article data-reveal><span>03</span><h3>Recipients are enforced</h3><p>Every recipient is checked before SirenoRELAY hands a message to the upstream provider.</p></article>
        <article data-reveal><span>04</span><h3>Access is rechecked</h3><p>Bearer-token bindings and current policy are checked again for every operation.</p></article>
      </div>
    </section>

    <section id="architecture" class="security-band shell" aria-labelledby="security-title" data-reveal>
      <div class="security-copy"><p class="eyebrow">THE CREDENTIAL STAYS WITH THE OWNER</p><h2 id="security-title">An MCP tool call.<br /><em>Not a mailbox login.</em></h2><p>The agent sends a bearer token to SirenoRELAY’s MCP endpoint. SirenoRELAY—not the agent—loads the IMAP/SMTP credentials, talks to the mail server, applies policy, and returns only the allowed result.</p></div>
      <div class="security-stack" role="group" aria-label="Credential boundary flow">
        <div><b>Agent</b><small>MCP tool call + scoped bearer token</small></div><i>→</i>
        <div class="security-gateway"><b>SirenoRELAY</b><small>Owns credentials · checks policy · filters results</small></div><i>→</i>
        <div><b>Mail server</b><small>Upstream credentials stay on this side</small></div>
      </div>
      <p class="security-deploy">Run it under a dedicated OS service user or in an isolated container the agent cannot inspect. Do not give the agent access to the config, secret files, process environment, or a direct upstream route. <a href={withBase("/docs/security")}>Read the security model →</a></p>
    </section>

    <section id="install" class="install-section shell" aria-labelledby="install-title" data-reveal>
      <div class="install-heading"><p class="eyebrow"><span class="eyebrow-mark"></span> OWNER OPERATED</p><h2 id="install-title">Start with a key.<br />Not a compromise.</h2><p>Install the relay in the owner-controlled environment. The agent gets a scoped token—not a way into the mailbox.</p></div>
      <div class="install-card">
        <div class="install-card-top"><span>01 / INSTALL</span><span>MACOS · LINUX</span></div>
        <p><b>Homebrew</b> <span>Available after the first release.</span></p>
        <code><small>$</small> brew install sergiocarracedo/tap/sirenorelay</code>
        <div class="install-rule"></div>
        <p><b>Agent-guided setup</b> <span>Install the skill, then ask your agent to use it.</span></p>
        <Button variant="compact" data-copy-prompt>Copy agent setup prompt <span aria-hidden="true">↗</span></Button>
        <span class="copy-status" role="status" aria-live="polite" data-copy-status></span>
        <details><summary>Preview the owner-safe prompt</summary><pre data-setup-prompt>{setupPrompt}</pre></details>
      </div>
    </section>

    <section id="security" class="docs-cta shell" data-reveal>
       <div><p class="eyebrow">OWNER-OPERATED</p><h2>Configure the boundary.<br />Then hand over one token.</h2></div>
       <div><p>Start with interactive onboarding, inspect the policy model, and keep upstream credentials outside the agent’s reach.</p><Button href={withBase("/docs")}>Read the docs <span>→</span></Button></div>
    </section>
  </main>
  <SiteFooter />
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-prompt]");
    copyButton?.addEventListener("click", async () => {
      const prompt = document.querySelector<HTMLElement>("[data-setup-prompt]");
      const status = document.querySelector<HTMLElement>("[data-copy-status]");
      if (!prompt || !status) return;
      try {
        await navigator.clipboard.writeText(prompt.textContent?.trim() ?? "");
        status.textContent = "Prompt copied.";
      } catch {
        prompt.closest("details")?.setAttribute("open", "");
        status.textContent = "Copy unavailable. Select the prompt below to copy it.";
      }
    });
  </script>
</SiteLayout>
