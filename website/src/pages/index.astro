---
import BrandLink from "../components/BrandLink.astro";
import MailBoundaryDiagram from "../components/MailBoundaryDiagram.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/with-base";
import { version } from "../lib/version";

const setupPrompt = "First install the SirenoRELAY setup skill with `npx skills add sergiocarracedo/sireno-relay --skill sirenorelay`. Then read and use that skill to help me install and configure SirenoRELAY on an owner-controlled account. Verify the Homebrew formula is published before using it. Keep upstream mail credentials and the relay configuration out of the agent environment; guide me through onboarding and policy validation without asking me to paste secrets into chat.";
---

<SiteLayout title="SirenoRELAY — constrained email for agents" description="Give agents narrowly scoped, policy-filtered email access without upstream credentials.">
  <header class="site-header shell">
    <BrandLink />
    <nav aria-label="Main navigation"><a href={withBase("/docs")}>Docs</a><a href="https://github.com/sergiocarracedo/sireno-relay">GitHub ↗</a></nav>
  </header>
  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">MCP EMAIL BOUNDARY <span>v{version}</span></p>
        <h1>Give agents access.<br /><em>Not your inbox.</em></h1>
        <p class="lede">SirenoRELAY gives an agent a narrow, policy-filtered mailbox view — without upstream credentials or a path around your rules.</p>
        <div class="hero-actions"><a class="button button--solid" href={withBase("/docs/onboarding")}>Set up an agent <span>→</span></a><a class="button button--text" href="#boundary">See the boundary <span>↓</span></a></div>
      </div>
      <aside class="install-card" data-reveal>
        <div class="terminal-bar"><span></span><span></span><span></span><b>install</b></div>
        <p><b>Homebrew · after the first release.</b> Installs Himalaya too.</p>
        <code><small>$</small> brew install sergiocarracedo/tap/sirenorelay</code>
        <code class="subtle"><small>$</small> sirenorelay --version</code>
        <div class="install-agent">
          <p>Prefer an agent-guided setup? Give your agent the skill first.</p>
          <button type="button" data-copy-prompt>Copy agent setup prompt <span aria-hidden="true">↗</span></button>
          <span class="copy-status" role="status" aria-live="polite" data-copy-status></span>
          <details><summary>Preview prompt</summary><pre data-setup-prompt>{setupPrompt}</pre></details>
        </div>
      </aside>
    </section>

    <div id="boundary" class="shell"><MailBoundaryDiagram /></div>

    <section class="feature-band shell" aria-labelledby="features-title">
      <div class="feature-intro" data-reveal><p class="eyebrow">THE CONTROL PLANE</p><h2 id="features-title">A mailbox view shaped by policy, not trust.</h2></div>
      <div class="feature-grid">
        <article data-reveal><span>01</span><h3>Folders disappear</h3><p>Unapproved folders never become part of the agent’s mailbox view or virtual IDs.</p></article>
        <article data-reveal><span>02</span><h3>Senders are checked</h3><p>An allowed recipient cannot make an unapproved <code>From</code> sender visible.</p></article>
        <article data-reveal><span>03</span><h3>Recipients are enforced</h3><p>Every recipient is checked before SirenoRELAY hands a message to the upstream provider.</p></article>
        <article data-reveal><span>04</span><h3>Access is rechecked</h3><p>Bearer-token bindings and current policy are checked again for every operation.</p></article>
      </div>
    </section>

    <section class="security-band shell" aria-labelledby="security-title" data-reveal>
      <div class="security-copy"><p class="eyebrow">THE CREDENTIAL STAYS WITH THE OWNER</p><h2 id="security-title">An MCP tool call.<br /><em>Not a mailbox login.</em></h2><p>The agent sends a bearer token to SirenoRELAY’s MCP endpoint. SirenoRELAY—not the agent—loads the IMAP/SMTP credentials, talks to the mail server, applies policy, and returns only the allowed result.</p></div>
      <div class="security-stack" role="group" aria-label="Credential boundary flow">
        <div><b>Agent</b><small>MCP tool call + scoped bearer token</small></div><i>→</i>
        <div class="security-gateway"><b>SirenoRELAY</b><small>Owns credentials · checks policy · filters results</small></div><i>→</i>
        <div><b>Mail server</b><small>Upstream credentials stay on this side</small></div>
      </div>
      <p class="security-deploy">Run it under a dedicated OS service user or in an isolated container the agent cannot inspect. Do not give the agent access to the config, secret files, process environment, or a direct upstream route. <a href={withBase("/docs/security")}>Read the security model →</a></p>
    </section>

    <section class="docs-cta shell" data-reveal>
      <div><p class="eyebrow">OWNER-OPERATED</p><h2>Configure the boundary.<br />Then hand over one token.</h2></div>
      <div><p>Start with interactive onboarding, inspect the policy model, and keep upstream credentials outside the agent’s reach.</p><a class="button button--solid" href={withBase("/docs")}>Read the docs <span>→</span></a></div>
    </section>
  </main>
  <footer class="site-footer shell"><span>SirenoRELAY</span><span>Default deny, by design.</span><span>v{version}</span></footer>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-prompt]");
    copyButton?.addEventListener("click", async () => {
      const prompt = document.querySelector<HTMLElement>("[data-setup-prompt]");
      const status = document.querySelector<HTMLElement>("[data-copy-status]");
      if (!prompt || !status) return;
      try {
        await navigator.clipboard.writeText(prompt.textContent?.trim() ?? "");
        status.textContent = "Prompt copied.";
      } catch {
        prompt.closest("details")?.setAttribute("open", "");
        status.textContent = "Copy unavailable. Select the prompt below to copy it.";
      }
    });
  </script>
</SiteLayout>
