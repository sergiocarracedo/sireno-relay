---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/with-base";
---

<SiteLayout title="Attributions — SirenoRELAY" description="Attributions and licenses for third-party 3D assets used on SirenoRELAY.">
  <SiteHeader />
  <main class="shell docs-page">
    <header class="docs-header">
      <p class="eyebrow">CREDITS</p>
      <h1>3D asset attributions.</h1>
      <p>Models used in the SirenoRELAY hero scene.</p>
    </header>
    <section class="prose" aria-labelledby="officer-credit">
      <h2 id="officer-credit">Male Officer</h2>
      <p>
        “Male Officer” by <a href="https://poly.pizza/u/J-Toastie">J-Toastie</a>, via
        <a href="https://poly.pizza/m/ipEgtSYI8u">Poly Pizza</a>, licensed under
        <a href="https://creativecommons.org/licenses/by/3.0/">Creative Commons Attribution 3.0 (CC BY 3.0)</a>.
      </p>
    </section>
    <section class="prose" aria-labelledby="pickup-credit">
      <h2 id="pickup-credit">Pickup Truck</h2>
      <p>
        “Pickup Truck” by <a href="https://poly.pizza/u/Quaternius">Quaternius</a>, via
        <a href="https://poly.pizza/m/qn4grQgHm8">Poly Pizza</a>, released under
        <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a>.
      </p>
    </section>
    <section class="prose" aria-labelledby="road-credit">
      <h2 id="road-credit">Road</h2>
      <p>
        Road by Poly by Google [<a href="https://creativecommons.org/licenses/by/3.0/">CC-BY</a>]
        (https://creativecommons.org/licenses/by/3.0/) via Poly Pizza
        (<a href="https://poly.pizza/m/9RFlFC9Znk4">https://poly.pizza/m/9RFlFC9Znk4</a>)
      </p>
    </section>
    <section class="prose" aria-labelledby="box-credit">
      <h2 id="box-credit">Box</h2>
      <p>
        “Box” by <a href="https://poly.pizza/u/Kay%20Lousberg">Kay Lousberg</a>, via
        <a href="https://poly.pizza/m/ykZ23x9d6p">Poly Pizza</a>, released under
        <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a>.
      </p>
    </section>
    <section class="prose" aria-labelledby="exclamation-credit">
      <h2 id="exclamation-credit">Cube Exclamation</h2>
      <p>
        “Cube Exclamation” by <a href="https://poly.pizza/u/Quaternius">Quaternius</a>, via
        <a href="https://poly.pizza/m/5UhMsny9iP">Poly Pizza</a>, released under
        <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a>.
      </p>
    </section>
    <section class="prose" aria-labelledby="bomb-credit">
      <h2 id="bomb-credit">Bomb</h2>
      <p>
        “Bomb” by <a href="https://poly.pizza/u/Quaternius">Quaternius</a>, via
        <a href="https://poly.pizza/m/0oNZ1y6ghg">Poly Pizza</a>, released under
        <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a>.
      </p>
    </section>
    <section class="prose" aria-labelledby="tower-credit">
      <h2 id="tower-credit">Guard Tower</h2>
      <p>
        “Guard Tower” by <a href="https://poly.pizza/u/Quaternius">Quaternius</a>, via
        <a href="https://poly.pizza/m/sbaM8I229r">Poly Pizza</a>, released under
        <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0 1.0 Universal</a>.
      </p>
    </section>
    <p><a href={withBase("/")}>Return to SirenoRELAY</a></p>
  </main>
  <SiteFooter />
</SiteLayout>
