---
import { withBase } from "../lib/with-base";
---

<section class="relay-map" aria-label="Direct mailbox access and protected relay access diagram" data-reveal>
  <div class="shell">
    <figure class="relay-map__stage">
      <div class="relay-route relay-route--direct">
        <div class="route-label"><span class="route-label__dot"></span><b>Direct mailbox access</b><small>Agent holds upstream credentials</small></div>
        <div class="iso-scene iso-scene--risk" aria-hidden="true">
          <span class="iso-scene__badge">NO POLICY BOUNDARY</span>
          <div class="iso-world">
            <div class="iso-deck">
              <div class="iso-deck__top"></div><div class="iso-deck__front"></div><div class="iso-deck__side"></div>
            </div>
            <div class="iso-link iso-link--risk">
              <span class="iso-chip iso-chip--risk iso-chip--first">credentials</span>
              <span class="iso-chip iso-chip--risk iso-chip--second">all folders</span>
              <span class="iso-chip iso-chip--risk iso-chip--third">raw messages</span>
            </div>
            <div class="iso-machine iso-machine--agent">
              <div class="iso-machine__top"><span class="iso-machine__glyph">AI</span><span class="iso-machine__trace"></span></div>
              <div class="iso-machine__front"></div><div class="iso-machine__side"></div><div class="iso-machine__left"></div>
            </div>
            <div class="iso-machine iso-machine--mail">
              <div class="iso-machine__top"><span class="iso-machine__glyph">MAIL</span><span class="iso-machine__trace"></span></div>
              <div class="iso-machine__front"></div><div class="iso-machine__side"></div><div class="iso-machine__left"></div>
            </div>
          </div>
          <div class="iso-scene__outcomes">
            <div class="iso-outcome">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h7l2 2h10v10h-19z"/></svg>
              <span>Personal folder <strong>EXPOSED</strong></span>
            </div>
            <div class="iso-outcome">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
              <span>Confidential email <strong>EXPOSED</strong></span>
            </div>
          </div>
          <div class="iso-scene__legend"><span>AI AGENT</span><span>DIRECT CONNECTION</span><span>MAIL SERVER</span></div>
        </div>
        <p class="route-copy">The agent can use the mailbox credential directly. Folder and sender policy is not applied at the relay boundary, and sends bypass relay recipient checks.</p>
      </div>

      <div class="relay-route relay-route--protected">
        <div class="route-label"><span class="route-label__dot"></span><b>Protected relay gateway</b><small>Scoped bearer token + current policy</small></div>
        <div class="iso-scene iso-scene--safe" aria-hidden="true">
          <span class="iso-scene__badge">CREDENTIALS STAY WITH THE RELAY</span>
          <div class="iso-world">
            <div class="iso-deck">
              <div class="iso-deck__top"></div><div class="iso-deck__front"></div><div class="iso-deck__side"></div>
            </div>
            <div class="iso-link iso-link--token"><span class="iso-chip iso-chip--token">bearer token</span></div>
            <div class="iso-link iso-link--upstream"><span class="iso-chip iso-chip--upstream">authorized request</span></div>
            <div class="iso-link iso-link--return"><span class="iso-chip iso-chip--return">allowed results</span></div>
            <div class="iso-link iso-link--rejected"><span class="iso-chip iso-chip--rejected">blocked</span></div>
            <div class="iso-machine iso-machine--agent">
              <div class="iso-machine__top"><span class="iso-machine__glyph">AI</span><span class="iso-machine__trace"></span></div>
              <div class="iso-machine__front"></div><div class="iso-machine__side"></div><div class="iso-machine__left"></div>
            </div>
            <div class="iso-machine iso-machine--gateway">
              <div class="iso-machine__top"><span class="iso-machine__glyph"><img src={withBase("/logo.png")} width="52" height="52" alt="" /></span><span class="iso-machine__trace"></span></div>
              <div class="iso-machine__front"></div><div class="iso-machine__side"></div><div class="iso-machine__left"></div>
            </div>
            <div class="iso-machine iso-machine--mail">
              <div class="iso-machine__top"><span class="iso-machine__glyph">MAIL</span><span class="iso-machine__trace"></span></div>
              <div class="iso-machine__front"></div><div class="iso-machine__side"></div><div class="iso-machine__left"></div>
            </div>
          </div>
          <div class="iso-checkpoint" aria-hidden="true">
            <div class="iso-checkpoint__guard"><svg viewBox="0 0 36 44"><path d="M9 14h18l-3-6H12zM12 16h12l4 17H8zM13 33v8m10-8v8M9 21l-6 8m24-8 6 8"/><path d="M15 21h6v8h-6z"/></svg><span>POLICY<br />CONTROL</span></div>
            <div class="iso-checkpoint__barrier"><i></i><b></b><b></b></div>
            <div class="iso-parcel iso-parcel--personal"><span>×</span><small>PERSONAL</small></div>
            <div class="iso-parcel iso-parcel--confidential"><span>×</span><small>PRIVATE</small></div>
            <div class="iso-parcel iso-parcel--cleared"><span>✓</span><small>ALLOWED</small></div>
          </div>
          <div class="iso-scene__outcomes">
            <div class="iso-outcome">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 6.5h7l2 2h10v10h-19z"/></svg>
              <span>Personal folder <strong>BLOCKED</strong></span>
            </div>
            <div class="iso-outcome">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/></svg>
              <span>Confidential email <strong>BLOCKED</strong></span>
            </div>
          </div>
          <div class="iso-scene__legend"><span>AI AGENT</span><span>TOKEN + POLICY</span><span>MAIL SERVER</span></div>
        </div>
        <p class="route-copy">SirenoRELAY owns upstream credentials, authenticates the agent token, filters folders and messages, and checks outbound recipients before handoff.</p>
      </div>
    </figure>
  </div>
</section>
